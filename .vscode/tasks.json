{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build APK (assembleDebug)",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install & Launch on Android Device",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug && %LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe shell am start -n com.example.twisty/.MainActivity",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": ".\\gradlew.bat testDebugUnitTest",
      "problemMatcher": []
    },
    {
      "label": "Check Connected Devices (ADB)",
      "type": "shell",
      "command": "%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe devices",
      "problemMatcher": []
    }
  ]
}
